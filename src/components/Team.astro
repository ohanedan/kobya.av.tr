---
import Monogram from './Monogram.astro';
import Lines from './Lines.astro';
import { content, type Lang } from '../i18n/content';
import { firm } from '../data/firm';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const profiles = firm.linkedin as Record<string, string | undefined>;

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
---

<section class="section section-light team" id={t.ids.team} data-section="team">
  <div class="container">
    <h2 class="section-title team-title" data-lines><Lines lines={t.team.titleLines} /></h2>

    <div class="team-grid">
      <div class="team-aside">
        <figure class="emblem" data-emblem>
          <div class="emblem-box">
            <div class="emblem-frame">
              <div class="emblem-inner" data-emblem-inner>
                <svg class="emblem-ring" viewBox="0 0 200 200" aria-hidden="true">
                  <defs>
                    <path id="emblem-ring-path" d="M100,100 m-84,0 a84,84 0 1,1 168,0 a84,84 0 1,1 -168,0"></path>
                  </defs>
                  <text>
                    <textPath href="#emblem-ring-path" textLength="526" lengthAdjust="spacing">{t.team.ring}</textPath>
                  </text>
                </svg>
                <Monogram class="emblem-mark" />
              </div>
              <div class="emblem-meta emblem-meta-top" aria-hidden="true">
                <span>Kobya</span><span>{t.header.sub}</span>
              </div>
              <div class="emblem-meta emblem-meta-bottom" aria-hidden="true">
                <span>{firm.address.city}</span><span>Türkiye</span>
              </div>
            </div>
          </div>
        </figure>
      </div>

      <ol class="team-list" data-stagger>
        {
          t.team.members.map((member) => (
            <li class="member" data-stagger-item>
              <p class="member-role">{member.role}</p>
              <h3 class="member-name">
                {member.prefix ? `${member.prefix} ` : ''}
                {member.name}
              </h3>
              <div class="member-bio">
                {member.bio.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              {profiles[member.key] && (
                <a class="text-link" href={profiles[member.key]} target="_blank" rel="noopener noreferrer">
                  {t.team.profileLabel}
                  <Fragment set:html={arrow} />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
