---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="section section-light office" id={t.ids.office} data-section="office">
  <div class="container">
    <h2 class="principles-label" data-reveal>{t.office.principlesLabel}</h2>
    <div class="principles" data-stagger>
      <span class="principles-rule" data-rule aria-hidden="true"></span>
      {
        t.office.principles.map((principle) => (
          <article class="principle" data-stagger-item>
            <h3 class="principle-title">{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
