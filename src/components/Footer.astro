---
import Monogram from './Monogram.astro';
import { content, type Lang, type NavKey } from '../i18n/content';
import { firm, links, resources } from '../data/firm';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
const navHref = (key: NavKey) => (key === 'top' ? '#top' : `#${t.ids[key]}`);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand" href="#top">
        <Monogram class="brand-mark" />
        <span class="brand-text">
          <span class="brand-name">Kobya</span>
          <span class="brand-sub">{t.header.sub}</span>
        </span>
      </a>
      <nav class="footer-nav" aria-label={t.header.navLabel}>
        <ul>
          {
            t.nav.map((item) => (
              <li>
                <a href={navHref(item.key)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="back-top" href="#top">
        <span>{t.footer.backToTop}</span>
        <span class="back-top-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M12 20V4M6 10l6-6 6 6"></path>
          </svg>
        </span>
      </a>
    </div>

    <address class="footer-nap">
      <span>{t.brand}</span>
      <span>
        {firm.address.street}, {firm.address.postalCode} {firm.address.district} / {firm.address.city}
      </span>
      <a href={links.tel}>{firm.phone.display}</a>
      <a href={links.mail}>{firm.email}</a>
    </address>

    <div class="footer-panels">
      <section class="footer-panel footer-resources">
        <h2 class="meta-label">{t.footer.resourcesTitle}</h2>
        <ul class="resource-list">
          {
            resources.map((resource) => (
              <li>
                <a href={resource.url} target="_blank" rel="noopener noreferrer">
                  {resource.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="footer-panel footer-declaration">
        <h2 class="meta-label">{t.footer.declarationTitle}</h2>
        <p>{t.footer.declaration}</p>
      </section>
    </div>

    <div class="footer-bottom">
      <p>© {year} {t.brand}. {t.footer.rights}</p>
      <p>{t.footer.privacy}</p>
    </div>
  </div>
</footer>
