---
/** The Kobya "K" monogram. Every stroke has pathLength=1 so it can be drawn with stroke-dashoffset. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['monogram', className]}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="32" cy="32" r="30.5" pathLength="1"></circle>
  <circle cx="32" cy="32" r="27.25" pathLength="1" stroke-opacity="0.4" stroke-width="0.6"></circle>
  <path d="M24 17v30" pathLength="1"></path>
  <path d="M24 35 42 17" pathLength="1"></path>
  <path d="M30.5 28.5 43 47" pathLength="1"></path>
  <path d="M19.5 17h9M19.5 47h9M38 17h8M38.5 47h8" pathLength="1"></path>
</svg>
