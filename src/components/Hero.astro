---
import Monogram from './Monogram.astro';
import Lines from './Lines.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const areas = t.practice.areas.map((area) => area.title);
const marquee = [...areas, ...areas];
---

<section class="hero" id="top" data-hero data-glow-area>
  <div class="hero-bg" aria-hidden="true">
    <div class="glow" data-glow></div>
    <div class="container hero-grid" data-hero-grid>
      <span></span><span></span><span></span><span></span>
    </div>
    <Monogram class="hero-watermark" />
    <div class="grain"></div>
  </div>

  <div class="container hero-inner" data-hero-inner>
    <h1 class="hero-title" data-hero-title>
      <span class="sr-only">{t.brand} — </span>
      <Lines lines={t.hero.titleLines} />
    </h1>

    <div class="hero-bottom">
      <p class="hero-lead" data-hero-rise>{t.hero.lead}</p>
      <div class="hero-cta" data-hero-fade>
        <a class="btn-circle" href={`#${t.ids.contact}`} data-magnetic>
          <span class="btn-circle-text">{t.hero.cta}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M4 12h16M14 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" data-marquee>
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {marquee.map((area) => (
              <>
                <span class="marquee-item">{area}</span>
                <span class="marquee-star">✦</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
