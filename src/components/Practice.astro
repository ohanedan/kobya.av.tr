---
import Lines from './Lines.astro';
import { content, type Lang } from '../i18n/content';
import { pad } from '../lib/text';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="section section-dark practice" id={t.ids.practice} data-section="practice">
  <div class="grain" aria-hidden="true"></div>
  <div class="container practice-grid">
    <div class="practice-aside">
      <div class="practice-sticky">
        <h2 class="section-title" data-lines><Lines lines={t.practice.titleLines} /></h2>
        <p class="section-intro" data-reveal>{t.practice.intro}</p>
      </div>
    </div>

    <ol class="practice-list" data-stagger data-practice-list>
      {
        t.practice.areas.map((area, index) => (
          <li class:list={['practice-item', { 'is-open': index === 0 }]} data-practice-item data-stagger-item>
            <h3>
              <button
                class="practice-head"
                type="button"
                id={`area-head-${index}`}
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`area-body-${index}`}
              >
                <span class="practice-num">{pad(index + 1)}</span>
                <span class="practice-name">{area.title}</span>
                <span class="practice-icon" aria-hidden="true" />
              </button>
            </h3>
            <div class="practice-body" id={`area-body-${index}`} role="region" aria-labelledby={`area-head-${index}`}>
              <div class="practice-body-inner">
                <p>{area.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
