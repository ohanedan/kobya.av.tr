---
import { content, type Lang } from '../i18n/content';
import { homePath } from '../lib/nav';

interface Props {
  lang: Lang;
  /**
   * Where each language button leads, base path included. Defaults to the two home pages, where
   * the script then appends the section the visitor is looking at; a question page passes its own.
   */
  paths?: Record<Lang, string>;
}

const { lang, paths } = Astro.props;
/* Section mapping only makes sense on the home page, which is the default target. */
const mapsSections = !paths;
const targets = paths ?? { tr: homePath('tr'), en: homePath('en') };
const languages: { code: Lang; href: string; name: string }[] = [
  { code: 'tr', href: targets.tr, name: 'Türkçe' },
  { code: 'en', href: targets.en, name: 'English' },
];
---

<div class="lang-switch" role="group" aria-label={content[lang].header.langLabel}>
  {
    languages.map((language, index) => (
      <>
        {index > 0 && (
          <span class="lang-sep" aria-hidden="true">
            /
          </span>
        )}
        <a
          href={language.href}
          hreflang={language.code}
          lang={language.code}
          aria-label={language.name}
          aria-current={language.code === lang ? 'page' : undefined}
          data-lang-link
          data-ids={mapsSections ? JSON.stringify(content[language.code].ids) : undefined}
        >
          {language.code.toUpperCase()}
        </a>
      </>
    ))
  }
</div>
