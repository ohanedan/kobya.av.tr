---
import type { GetStaticPaths } from 'astro';
import QuestionArticle from '../../../components/QuestionArticle.astro';
import { getQuestionPages, getQuestions } from '../../../lib/questions';

export const getStaticPaths = (async () => {
  const all = await getQuestions('en');
  const pages = await getQuestionPages('en');
  return pages.map(({ slug, question }) => ({ params: { slug }, props: { question, all } }));
}) satisfies GetStaticPaths;

const { question, all } = Astro.props;
---

<QuestionArticle lang="en" question={question} all={all} />
